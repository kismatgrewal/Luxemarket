# ---------------------------------------------------------------------------
# LuxeMarket environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres connection string (Prisma).
DATABASE_URL="postgresql://luxe:luxe@localhost:5432/luxemarket?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-one-with-openssl-rand-base64-32"

# Stripe (test mode keys)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Marketplace connected-account payouts
STRIPE_CONNECT_CLIENT_ID="ca_xxx"

# OpenAI — product-description generation
OPENAI_API_KEY="sk-xxx"
OPENAI_MODEL="gpt-4o-mini"

# n8n automation webhooks
N8N_WEBHOOK_URL="https://n8n.example.com/webhook"
N8N_WEBHOOK_SECRET="replace-me"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LuxeMarket"
